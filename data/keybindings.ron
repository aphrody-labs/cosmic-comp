// Bun OS: Omarchy keymap on cosmic-comp. Window, workspace and utility keys follow Omarchy 3.8.4
// default/hypr/bindings/{tiling-v2,utilities}.conf and config/hypr/bindings.conf (basecamp/omarchy, MIT),
// mapped onto cosmic-comp actions; COSMIC-only actions (app library, overview, output moves) keep free keys.
// Installed as /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/defaults; users add their own in
// Settings > Keyboard > Shortcuts (key `custom`), which override these.
{
    // Session
    (modifiers: [Super, Alt], key: "Escape"): Terminate,
    (modifiers: [Super, Shift], key: "Escape"): System(LogOut),
    (modifiers: [Super, Ctrl], key: "Escape"): Debug,
    (modifiers: [Super], key: "Escape"): System(PowerOff),
    (modifiers: [Super, Ctrl], key: "l"): System(LockScreen),

    // Launchers and menus (Omarchy: Super+Space apps, Super+Alt+Space menu; COSMIC: Super+A app library)
    (modifiers: [Super], key: "space"): System(Launcher),
    (modifiers: [Super, Alt], key: "space"): System(Launcher),
    (modifiers: [Super]): System(Launcher),
    (modifiers: [Super], key: "a"): System(AppLibrary),
    (modifiers: [Super], key: "grave"): System(WorkspaceOverview),
    (modifiers: [], key: "XF86LaunchA"): System(WorkspaceOverview),
    (modifiers: [Super], key: "k"): Spawn("cosmic-settings keyboard shortcuts"),
    (modifiers: [Super, Ctrl], key: "space"): Spawn("cosmic-settings wallpaper"),
    (modifiers: [Super, Shift, Ctrl], key: "space"): Spawn("cosmic-settings appearance"),
    (modifiers: [Super, Ctrl, Alt], key: "space"): System(InputSourceSwitch),
    (modifiers: [Super], key: "i"): Spawn("cosmic-settings"),

    // Applications (Omarchy config/hypr/bindings.conf, Bun OS default apps)
    (modifiers: [Super], key: "Return"): System(Terminal),
    (modifiers: [Super, Alt], key: "Return"): Spawn("cosmic-term"),
    (modifiers: [Super, Shift], key: "Return"): System(WebBrowser),
    (modifiers: [Super, Shift], key: "b"): System(WebBrowser),
    (modifiers: [Super, Shift], key: "f"): System(HomeFolder),
    (modifiers: [Super, Shift], key: "n"): Spawn("cosmic-edit"),
    (modifiers: [Super, Shift], key: "d"): Spawn("spacedrive"),
    (modifiers: [Super, Shift], key: "i"): Spawn("cosmic-store"),
    (modifiers: [Super, Shift], key: "a"): Spawn("bunos-launch-webapp https://aphrody.com/chat com.aphrody.Chat"),
    (modifiers: [Super, Shift], key: "slash"): Spawn("bunos-launch-webapp https://aphrody.com/search com.aphrody.Search"),
    (modifiers: [Super, Shift], key: "w"): Spawn("wordcraft"),
    (modifiers: [Super, Shift], key: "g"): Spawn("retroarch"),
    (modifiers: [Super, Ctrl], key: "t"): Spawn("rio -e btop"),

    // Windows (Omarchy tiling-v2)
    (modifiers: [Super], key: "w"): Close,
    (modifiers: [Super], key: "q"): Close,
    (modifiers: [Alt], key: "F4"): Close,
    (modifiers: [Super], key: "t"): ToggleWindowFloating,
    (modifiers: [Super], key: "f"): Fullscreen,
    (modifiers: [Super], key: "F11"): Fullscreen,
    (modifiers: [Super, Alt], key: "f"): Maximize,
    (modifiers: [Super], key: "m"): Maximize,
    (modifiers: [Super], key: "j"): ToggleOrientation,
    (modifiers: [Super], key: "l"): ToggleTiling,
    (modifiers: [Super], key: "o"): ToggleSticky,
    (modifiers: [Super], key: "g"): ToggleStacking,
    (modifiers: [Super], key: "s"): ToggleStacking,
    (modifiers: [Super], key: "x"): SwapWindow,
    (modifiers: [Super], key: "minus"): Resizing(Inwards),
    (modifiers: [Super], key: "equal"): Resizing(Outwards),
    (modifiers: [Super], key: "r"): Resizing(Outwards),
    (modifiers: [Super, Shift], key: "r"): Resizing(Inwards),

    (modifiers: [Super], key: "Left"): Focus(Left),
    (modifiers: [Super], key: "Right"): Focus(Right),
    (modifiers: [Super], key: "Up"): Focus(Up),
    (modifiers: [Super], key: "Down"): Focus(Down),
    (modifiers: [Super], key: "u"): Focus(Out),
    (modifiers: [Super, Shift], key: "Left"): Move(Left),
    (modifiers: [Super, Shift], key: "Right"): Move(Right),
    (modifiers: [Super, Shift], key: "Up"): Move(Up),
    (modifiers: [Super, Shift], key: "Down"): Move(Down),

    (modifiers: [Alt], key: "Tab"): System(WindowSwitcher),
    (modifiers: [Alt, Shift], key: "Tab"): System(WindowSwitcherPrevious),
    (modifiers: [Ctrl, Alt], key: "Tab"): NextOutput,
    (modifiers: [Ctrl, Alt, Shift], key: "Tab"): PreviousOutput,

    // Workspaces (Omarchy: 1..9 and 0 = 10; Super+Tab cycles; Shift moves, Shift+Alt sends silently)
    (modifiers: [Super], key: "1"): Workspace(1),
    (modifiers: [Super], key: "2"): Workspace(2),
    (modifiers: [Super], key: "3"): Workspace(3),
    (modifiers: [Super], key: "4"): Workspace(4),
    (modifiers: [Super], key: "5"): Workspace(5),
    (modifiers: [Super], key: "6"): Workspace(6),
    (modifiers: [Super], key: "7"): Workspace(7),
    (modifiers: [Super], key: "8"): Workspace(8),
    (modifiers: [Super], key: "9"): Workspace(9),
    (modifiers: [Super], key: "0"): Workspace(10),
    (modifiers: [Super, Shift], key: "1"): MoveToWorkspace(1),
    (modifiers: [Super, Shift], key: "2"): MoveToWorkspace(2),
    (modifiers: [Super, Shift], key: "3"): MoveToWorkspace(3),
    (modifiers: [Super, Shift], key: "4"): MoveToWorkspace(4),
    (modifiers: [Super, Shift], key: "5"): MoveToWorkspace(5),
    (modifiers: [Super, Shift], key: "6"): MoveToWorkspace(6),
    (modifiers: [Super, Shift], key: "7"): MoveToWorkspace(7),
    (modifiers: [Super, Shift], key: "8"): MoveToWorkspace(8),
    (modifiers: [Super, Shift], key: "9"): MoveToWorkspace(9),
    (modifiers: [Super, Shift], key: "0"): MoveToWorkspace(10),
    (modifiers: [Super, Shift, Alt], key: "1"): SendToWorkspace(1),
    (modifiers: [Super, Shift, Alt], key: "2"): SendToWorkspace(2),
    (modifiers: [Super, Shift, Alt], key: "3"): SendToWorkspace(3),
    (modifiers: [Super, Shift, Alt], key: "4"): SendToWorkspace(4),
    (modifiers: [Super, Shift, Alt], key: "5"): SendToWorkspace(5),
    (modifiers: [Super, Shift, Alt], key: "6"): SendToWorkspace(6),
    (modifiers: [Super, Shift, Alt], key: "7"): SendToWorkspace(7),
    (modifiers: [Super, Shift, Alt], key: "8"): SendToWorkspace(8),
    (modifiers: [Super, Shift, Alt], key: "9"): SendToWorkspace(9),
    (modifiers: [Super, Shift, Alt], key: "0"): SendToWorkspace(10),
    (modifiers: [Super], key: "Tab"): NextWorkspace,
    (modifiers: [Super, Shift], key: "Tab"): PreviousWorkspace,
    (modifiers: [Super, Ctrl], key: "Tab"): LastWorkspace,
    (modifiers: [Super, Ctrl], key: "Right"): NextWorkspace,
    (modifiers: [Super, Ctrl], key: "Left"): PreviousWorkspace,
    (modifiers: [Super, Shift, Ctrl], key: "Right"): MoveToNextWorkspace,
    (modifiers: [Super, Shift, Ctrl], key: "Left"): MoveToPreviousWorkspace,

    // Outputs (COSMIC)
    (modifiers: [Super, Alt], key: "Left"): SwitchOutput(Left),
    (modifiers: [Super, Alt], key: "Right"): SwitchOutput(Right),
    (modifiers: [Super, Alt], key: "Up"): SwitchOutput(Up),
    (modifiers: [Super, Alt], key: "Down"): SwitchOutput(Down),
    (modifiers: [Super, Shift, Alt], key: "Left"): MigrateWorkspaceToOutput(Left),
    (modifiers: [Super, Shift, Alt], key: "Right"): MigrateWorkspaceToOutput(Right),
    (modifiers: [Super, Shift, Alt], key: "Up"): MigrateWorkspaceToOutput(Up),
    (modifiers: [Super, Shift, Alt], key: "Down"): MigrateWorkspaceToOutput(Down),

    // Capture, zoom, accessibility (Omarchy utilities)
    (modifiers: [], key: "Print"): System(Screenshot),
    (modifiers: [Super, Shift], key: "s"): System(Screenshot),
    (modifiers: [Super, Ctrl], key: "z"): ZoomIn,
    (modifiers: [Super, Ctrl, Alt], key: "z"): ZoomOut,
    (modifiers: [Super, Alt], key: "s"): System(ScreenReader),

    // Hardware keys (COSMIC defaults)
    (modifiers: [], key: "XF86AudioRaiseVolume"): System(VolumeRaise),
    (modifiers: [], key: "XF86AudioLowerVolume"): System(VolumeLower),
    (modifiers: [], key: "XF86AudioMute"): System(Mute),
    (modifiers: [], key: "XF86AudioMicMute"): System(MuteMic),
    (modifiers: [], key: "XF86MonBrightnessUp"): System(BrightnessUp),
    (modifiers: [], key: "XF86MonBrightnessDown"): System(BrightnessDown),
    (modifiers: [], key: "XF86AudioPlay"): System(PlayPause),
    (modifiers: [], key: "XF86AudioPrev"): System(PlayPrev),
    (modifiers: [], key: "XF86AudioNext"): System(PlayNext),
    (modifiers: [], key: "XF86PowerOff"): System(PowerOff),
    (modifiers: [], key: "XF86TouchpadToggle"): System(TouchpadToggle),
    (modifiers: [Super, Ctrl], key: "XF86TouchpadToggle"): System(TouchpadToggle),
}
